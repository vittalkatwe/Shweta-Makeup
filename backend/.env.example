# Copy this file to ".env" in the same folder

PORT=5001
NODE_ENV=development
LOG_LEVEL=info

# Browser origins allowed by CORS, comma-separated.
# Production: https://shwetamakeover.online,https://www.shwetamakeover.online,https://<admin>.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# PostgreSQL (managed, e.g. Neon/Supabase).
# DATABASE_URL = pooled connection used at runtime (PgBouncer / Neon pooler).
# DIRECT_URL   = direct (non-pooled) connection used by `prisma migrate`.
# Local dev against the docker compose db (npm run dev:db):
#   DATABASE_URL=postgresql://shweta:shweta@localhost:5432/shweta_dev
#   DIRECT_URL=postgresql://shweta:shweta@localhost:5432/shweta_dev
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require&pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# Source database for the one-time Mongo->Postgres ETL only (scripts/migrate-mongo-to-pg.js).
# Not used by the running server; remove after cutover.
# MONGODB_URI=mongodb://localhost:27017/your_db_name

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

EMAIL_USER=yourgmailaddress@gmail.com
EMAIL_PASS=your_gmail_app_password

# Mixpanel server-side events
MIXPANEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Meta (Facebook)
META_PIXEL_ID=xxxxxxxxxxxxxxx
META_CAPI_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
META_MARKETING_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
META_AD_ACCOUNT_ID=xxxxxxxxxxxxxxx
