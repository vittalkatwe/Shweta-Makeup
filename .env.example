# Root env file — used by docker compose. Copy to ".env" at the repo root.
#
# ── Local dev (docker-compose.yml) ─────────────────────────────────────────
# Postgres credentials for the dev database container (defaults shown).
#POSTGRES_USER=shweta
#POSTGRES_PASSWORD=shweta
#POSTGRES_DB=shweta_dev
#POSTGRES_PORT=5432

# ── Production (docker-compose.prod.yml) ───────────────────────────────────
# Frontend build args. BAKED INTO THE JS BUNDLE AT BUILD TIME — after changing
# any value here, rebuild: docker compose -f docker-compose.prod.yml up -d --build web
REACT_APP_BACKEND_URL=https://shwetamakeover.online
REACT_APP_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxx
VITE_CLEVERTAP_ACCOUNT_ID=xxx-xxx-xxxx
VITE_FIREBASE_API_KEY=xxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=xxxx.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000
VITE_FIREBASE_APP_ID=1:000:web:xxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXX
